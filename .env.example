# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth
JWT_SECRET=change-me-min-32-chars
JWT_EXPIRES_DAYS=7
NODE_ENV=development
PORT=3002

# WhatChimp WhatsApp API (jamais dans le front) — text messages
WHATCHIMP_API_KEY=your_whatchimp_api_key
WHATCHIMP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Meta WhatsApp Cloud API — template messages
META_ACCESS_TOKEN=your_meta_access_token
# Meeting reminder template (cron + POST /meetings/:id/send-reminder) — 4 body vars: nom, date, heure, Meet URL
WA_MEETING_REMINDER_TEMPLATE=meeting_reminder_util
# Same without Meet link (phone calls) — 3 body vars: nom, date, heure
WA_MEETING_REMINDER_NOLINK_TEMPLATE=meeting_reminder_nolink_util

# Cloudinary (upload médias — ne jamais exposer API_SECRET côté front)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ClickUp webhooks (leads en temps réel)
CLICKUP_API_TOKEN=your_clickup_personal_api_token
CLICKUP_WEBHOOK_SECRET=your_clickup_webhook_secret
# Set to 1 to log rawBody length + expected vs received signature hex (never logs the secret)
# CLICKUP_WEBHOOK_DEBUG=1
# Comma-separated ClickUp list IDs to sync (required for multi-list)
CLICKUP_LIST_IDS=901214985003,901215231618,901216143943,901215097346
# Optional — auto-detected from GET /team if omitted
# CLICKUP_TEAM_ID=12345678
# CLICKUP_WEBHOOK_ENDPOINT=https://api.63agency.com/clickup/webhook

# SMTP (meetings, documents, formulaire contact vitrine)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=Contact@63agency.ma
SMTP_PASS=your_smtp_password
# Optional explicit From (sinon FROM_NAME + SMTP_USER)
# SMTP_FROM="63 Agency" <Contact@63agency.ma>
FROM_NAME=63 Agency
ADMIN_EMAIL=Contact@63agency.ma
# URL publique de l’API (logo signature email : /images/IMG_1260.JPEG)
# API_PUBLIC_URL=https://api.63agency.com
# Ou URL Cloudinary directe du logo :
# EMAIL_SIGNATURE_LOGO_URL=https://res.cloudinary.com/.../logo-63.jpg

# Google Meet (OAuth2 user credentials — création d’espaces Meet)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
