# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth
JWT_SECRET=change-me-min-32-chars
JWT_EXPIRES_DAYS=7
PORT=3002

# WhatChimp WhatsApp API (jamais dans le front)
WHATCHIMP_API_KEY=your_whatchimp_api_key
WHATCHIMP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Cloudinary (upload médias — ne jamais exposer API_SECRET côté front)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
