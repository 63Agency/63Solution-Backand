# Même style que Oum Palace : URL projet + service_role (secret) pour que Nest parle à Postgres via l’API Supabase.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_jwt...

# Optionnel (front / clé publishable) — non requis si service_role est défini
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_...

JWT_SECRET=remplacez_par_une_secret_longue_et_aleatoire_min_32_caracteres
JWT_EXPIRES_DAYS=7

# SMTP (envoi email de devis/facture en pièce jointe PDF)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=contact@example.com
SMTP_PASS=mot_de_passe_smtp
SMTP_SECURE=false
SMTP_FROM=63 Agency <contact@63agency.ma>

# Plus besoin de DATABASE_URL pour ce mode.

# Wati WhatsApp (token uniquement côté serveur — jamais dans le front)
# URL = endpoint API dans Wati → Settings → API Docs
WATI_API_URL=https://live-server-xxxxx.wati.io
WATI_API_TOKEN=wati_ad48784e-d588-4c33-82a6-db236242760e.-P89e8n6pehLzpP5XfzjadhuaUtHAMivE9a9fBZTqtqjV4Wyg2F32H3XDeM-n4m9ofspqthkPlB6QF6w0oTXCzp2UPuNcZN9ugqImJ_mRcmbWru6U17ApJq6cdyEgIDM
# Optionnel : numéro canal business (chiffres seuls, ex. 212612345678)
WATI_CHANNEL_NUMBER=
